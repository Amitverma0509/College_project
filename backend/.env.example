# Groq API key - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Render sets PORT automatically; only used locally
PORT=5000

# Where uploads/vector store/model cache live.
# On Render with a disk mounted at /var/data, set DATA_DIR=/var/data
# DATA_DIR=

# Allowed frontend origin(s), comma separated. Use your Render static site URL.
# Example: https://rag-frontend.onrender.com
CORS_ORIGIN=*

EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
MIN_SCORE=0.2
