# Groq API key - get one free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model used for answer generation
GROQ_MODEL=llama-3.1-8b-instant

# Server port
PORT=5000

# Embedding model (runs locally via @xenova/transformers, downloaded on first use)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Chunking config
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval config
TOP_K=5
MIN_SCORE=0.2
